
from textwrap import dedent

"You are a senior technical writer."

"Turn this developer log into a blog article."

"Requirements:"
"- Friendly tone"
"- Explain the motivation"
"- Explain implementation"
"- Explain challenges"
"- End with lessons learned"

"Developer Log:"

"Implemented refresh token rotation..."

class articlePrompt():
    """Article building prompt for LLM"""

    def __init__(self, log, style_profile: dict):
        log = self.log
        style_profile = self.style_profile

        style_profile = {
            "voice": "Conversational, reflective, technically competent",
            "opening_style": "Begins with the pain point before the solution",
            "paragraph_length": "Medium, conversational",
            "perspective": "First person",
            "technical_depth": "Progressively increases",
            "humor": "Sparse and understated",
            "transition_style": "Natural conversational bridges ('Now...', 'Mind you...')",
            "ending_style": "Reflective with practical encouragement",
            "primary_focus": "Decision-making over implementation details"
        }
    
    @staticmethod
    def writing_style(self, previous_work: str | None) -> str:
        f"""
        Build the writing style context from a user's previous article.
        This is NOT content to copy.
        It is an example of the author's writing DNA. 
        Where no previous work has been added use the style_profile as the default structure
        style:
        ---------------------

        {self.style_profile}

        ---------------------
        """
        

        return dedent(
            f"""
            ## AUTHOR WRITING DNA

            The following article is an example of how the author naturally writes.

            Treat it as STYLE REFERENCE ONLY.

            Never copy sentences.
            Never reuse wording.
            Never paraphrase entire paragraphs.

            Instead infer the author's:

            • pacing
            • vocabulary
            • rhythm
            • paragraph length
            • storytelling structure
            • sentence complexity
            • transitions
            • tone
            • personality
            • level of technical depth
            • humor
            • confidence
            • preferred analogies
            • amount of explanation before introducing jargon
            • how conclusions are written
            • how introductions are written
            • use of first-person narration
            • use of rhetorical questions
            • emotional progression
            • balance between narrative and technical explanation

            Learn the author's voice.

            The output should feel as though the same person wrote it,
            while remaining entirely original.

            Previous article:

            --------------------------

            {previous_work}

            --------------------------
            """
        ).strip()


    @staticmethod
    def article(context: dict) -> str:
        return dedent(
            f"""
            You are a senior software engineer who also writes exceptional
            engineering blogs.

            Your objective is NOT to summarize.

            Your objective is to recreate the developer's journey.

            ## Article Information

            Title:
            {context["title"]}

            Project:
            {context["project_name"]}

            Language:
            {context["language"]}

            Framework:
            {context["framework"]}

            Developer Log:

            {context["description"]}

            ## Audience

            Software engineers.

            Junior developers.

            Curious builders.

            People who enjoy understanding *why* decisions were made,
            not only *what* happened.

            ## Writing Objectives

            Transform the developer log into a narrative article.

            The article should feel like someone sharing an engineering story,
            not documenting a changelog.

            ## Desired Structure

            1. Hook

            Open with the problem.

            Explain why it mattered.

            Make the reader curious.

            Do NOT immediately explain the solution.

            2. Context

            Explain what existed before.

            Explain why it became insufficient.

            Describe the constraints.

            3. Journey

            Walk through the thought process.

            Mention failed assumptions.

            Mention discoveries.

            Mention trade-offs.

            Mention uncertainty.

            Make the reader feel present.

            4. Technical Deep Dive

            Explain the implementation.

            Break complex concepts into digestible pieces.

            Introduce terminology only after sufficient context.

            Avoid unnecessary jargon.

            5. Lessons Learned

            Explain what surprised the developer.

            Explain what they would do differently.

            Explain why this knowledge matters.

            6. Closing

            End on a hopeful note.

            Encourage readers facing similar problems.

            ## Writing Rules

            Show reasoning before conclusions.

            Prefer stories over bullet points.

            Prefer paragraphs over lists.

            Vary sentence length.

            Avoid sounding like documentation.

            Avoid sounding like AI.

            Never overuse adjectives.

            Never exaggerate.

            Never invent events.

            Never fabricate implementation details.

            Expand naturally from the supplied log.

            Keep the article technically accurate.

            Every section should flow naturally into the next.

            The pacing should alternate between narrative and technical explanation.

            The reader should feel like they are following the author's thoughts in real time.

            Produce only the finished article.
            """
        ).strip()
    
    @staticmethod
    def summary(context: dict) -> str:
        return dedent(
            f"""
            Summarize the following developer log in under 100 words.
            Start the summary with "TL;DR:"
            "Include bullet points where necessary"

            Log:
            {context["description"]}
            """
        ).strip()

    @staticmethod
    def tags(context: dict) -> str:
        return dedent(
            f"""
            Generate up to five technical tags for this developer log.

            Log:
            {context["description"]}

            Return only a JSON array.
            """
        ).strip()

    @staticmethod
    def title(context: dict) -> str:
        return dedent(
            f"""
            Generate a concise, engaging title for the following developer log.

            Log:
            {context["description"]}
            """
        ).strip()

        